<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme -->
    <style name="Base.Theme.SimpleNotes" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/background_secondary</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Text appearance -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.SimpleNotes.Headline1</item>
        <item name="textAppearanceBody1">@style/TextAppearance.SimpleNotes.Body1</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SimpleNotes.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SimpleNotes.MediumComponent</item>

        <!-- Transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@transition/slide_right</item>
        <item name="android:windowExitTransition">@transition/fade</item>
    </style>

    <style name="Theme.SimpleNotes" parent="Base.Theme.SimpleNotes" />

    <!-- Text Appearances -->
    <style name="TextAppearance.SimpleNotes.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SimpleNotes.Body1" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.SimpleNotes.SmallComponent" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.SimpleNotes.MediumComponent" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- FAB Style -->
    <style name="Widget.SimpleNotes.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:layout_margin">24dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SimpleNotes.FAB</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/white</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="ShapeAppearance.SimpleNotes.FAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.SimpleNotes.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.SimpleNotes.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>
</resources>